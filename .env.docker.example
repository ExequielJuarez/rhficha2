# Opcional: copiá estas líneas a un archivo ".env" (junto a docker-compose.yml) para cambiar los valores por defecto.
# Si no existe, el sistema funciona igual con los valores por defecto de docker-compose.yml.

# Puerto por el que se entra al sistema: http://localhost:3000
FICHA_PUERTO=3000

# Contraseñas de los usuarios del sistema (se aplican la PRIMERA vez que se crea la base)
FICHA_ADMIN_PASSWORD=Ficha2026!
FICHA_USUARIO_PASSWORD=Usuario2026!

# Contraseñas de la base de datos (cambiarlas antes de la primera vez; la base no se publica hacia afuera)
FICHA_ROOT_PASSWORD=cambiar_esta_clave_root
FICHA_DB_PASSWORD=cambiar_esta_clave_db

# Clave de las sesiones (texto largo y aleatorio). Si se deja vacía, el contenedor genera una y la conserva.
FICHA_SESSION_SECRET=

# true solo si se publica detrás de HTTPS (cookies seguras). Con http://localhost debe ser false.
FICHA_COOKIE_SECURE=false

# Imagen de la base. Por defecto MariaDB 10.11 (probada). Para MySQL 8: mysql:8.0 (la comprobación de salud cambia)
# FICHA_DB_IMAGE=mariadb:10.11
