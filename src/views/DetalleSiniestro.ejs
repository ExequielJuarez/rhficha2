<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Siniestro - Ficha Técnica</title>
    <link rel="stylesheet" href="/css/CargaChofer.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .badge-estado { padding: 5px 12px; border-radius: 6px; font-weight: 800; font-size: 12px; text-transform: uppercase; }
        .badge-proceso { background-color: #fef08a; color: #9a3412; border: 1px solid #facc15; }
        .badge-resuelto { background-color: #bbf7d0; color: #166534; border: 1px solid #86efac; }

        #mobile-back-btn {
            background-color: #f8fafc;
            color: #475569;
            border: 1px solid #cbd5e1;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 700;
            border-radius: 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: 0.2s;
            margin-bottom: 20px;
            text-decoration: none;
        }
        #mobile-back-btn:hover { background-color: #e2e8f0; color: #0f172a; }
        #mobile-back-btn svg { width: 16px; height: 16px; }

        .detalle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

        .caja-seccion {
            background: white;
            padding: 24px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        .caja-titulo {
            font-size: 13px;
            font-weight: 800;
            color: #0f172a;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .spec-row { display: flex; flex-direction: column; margin-bottom: 14px; }
        .spec-label { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px; }
        .spec-value { font-size: 14px; font-weight: 600; color: #0f172a; }

        .archivo-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            margin-bottom: 8px;
            text-decoration: none;
            color: #334155;
            font-size: 13px;
            font-weight: 600;
            transition: 0.2s;
        }
        .archivo-item:hover { background: #e2e8f0; }
        .archivo-item svg { color: #2563eb; flex-shrink: 0; }

        .btn-resolver {
            background-color: #059669;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-resolver:hover { background-color: #047857; }

        .btn-eliminar {
            background-color: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-eliminar:hover { background-color: #dc2626; color: white; }

        .header-detalle {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .acciones-bottom {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        @media (max-width: 900px) {
            .detalle-grid { grid-template-columns: 1fr; gap: 0; }
            .header-detalle { flex-direction: column; }
            .header-detalle div:last-child { width: 100%; display: flex; flex-direction: column; gap: 10px; }
            .header-detalle div:last-child a,
            .header-detalle div:last-child button { width: 100%; justify-content: center; }
            .acciones-bottom { flex-direction: column-reverse; }
            .acciones-bottom form, .acciones-bottom button { width: 100%; }
            .acciones-bottom button { justify-content: center; }
            .caja-seccion { padding: 16px; }
        }

        @media (min-width: 900px) {
            #mobile-back-btn { display: none !important; }
        }
    </style>
</head>
<body>

    <%- include('./partials/sidebar') %>

    <div class="app-wrapper" id="app-wrapper">
        <%- include('./partials/topbar') %>

        <main class="main-content" style="padding: 30px; max-width: 1000px; margin: 0 auto;">

            <a href="/Siniestros" id="mobile-back-btn">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
                Volver a Siniestros
            </a>

            <div class="header-detalle">
                <div>
                    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px;">
                        <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0;">
                            Siniestro #<%= siniestro.id_siniestro %>
                        </h2>
                        <% if(siniestro.estado === 'RESUELTO') { %>
                            <span class="badge-estado badge-resuelto">Resuelto</span>
                        <% } else { %>
                            <span class="badge-estado badge-proceso">En Proceso</span>
                        <% } %>
                    </div>
                    <p style="color: #64748b; font-size: 14px; margin: 0;">
                        Registrado el <%= new Date(siniestro.createdAt).toLocaleDateString('es-AR') %>
                    </p>
                </div>

                <div style="display: flex; gap: 10px;">
                    <a href="/Siniestros" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver
                    </a>
                    <% if(siniestro.estado !== 'RESUELTO') { %>
                        <form action="/Siniestros/<%= siniestro.id_siniestro %>/resolver" method="POST" style="margin:0;" onsubmit="return confirm('¿Cerrar este caso? El vehículo y chofer quedarán disponibles.')">
                            <button type="submit" class="btn-resolver">
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Cerrar Caso
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>

            <%# VEHÍCULO Y CHOFER %>
            <div class="detalle-grid">
                <div class="caja-seccion">
                    <h4 class="caja-titulo">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #2563eb;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 1h6l2-1z"></path></svg>
                        Vehículo Involucrado
                    </h4>
                    <div class="spec-row">
                        <span class="spec-label">Patente</span>
                        <span class="spec-value" style="font-family: 'DM Mono', monospace; font-size: 20px; color: #2563eb;">
                            <%= siniestro.Vehiculo ? siniestro.Vehiculo.patente : '—' %>
                        </span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Marca / Modelo</span>
                        <span class="spec-value"><%= siniestro.Vehiculo ? siniestro.Vehiculo.marca + ' ' + siniestro.Vehiculo.modelo : '—' %></span>
                    </div>
                    <% if(siniestro.Vehiculo) { %>
                    <a href="/Vehicles/<%= siniestro.Vehiculo.id_vehiculo %>" style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: #2563eb; text-decoration: none; margin-top: 8px;">
                        Ver ficha del vehículo →
                    </a>
                    <% } %>
                </div>

                <div class="caja-seccion">
                    <h4 class="caja-titulo">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #7c3aed;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Chofer al Mando
                    </h4>
                    <% if(siniestro.Chofer) { %>
                        <div class="spec-row">
                            <span class="spec-label">Nombre</span>
                            <span class="spec-value"><%= siniestro.Chofer.nombre %> <%= siniestro.Chofer.apellido %></span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">DNI</span>
                            <span class="spec-value" style="font-family: 'DM Mono', monospace;"><%= siniestro.Chofer.dni || '—' %></span>
                        </div>
                    <% } else { %>
                        <p style="color: #94a3b8; font-size: 14px; margin: 0;">Sin chofer asignado (estacionado)</p>
                    <% } %>
                </div>
            </div>

            <%# DATOS DEL HECHO %>
            <div class="caja-seccion">
                <h4 class="caja-titulo">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #dc2626;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    Datos del Hecho
                </h4>
                <div class="detalle-grid">
                    <div class="spec-row">
                        <span class="spec-label">Fecha del Siniestro</span>
                        <span class="spec-value"><%= new Date(siniestro.fecha_siniestro).toLocaleDateString('es-AR') %></span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Ubicación</span>
                        <span class="spec-value"><%= siniestro.ubicacion || '—' %></span>
                    </div>
                </div>
                <div class="spec-row">
                    <span class="spec-label">Descripción de lo ocurrido</span>
                    <span class="spec-value" style="font-weight: 400; line-height: 1.6; color: #334155;"><%= siniestro.relato || '—' %></span>
                </div>
                <% if(siniestro.danos_vehiculo) { %>
                <div class="spec-row" style="margin-top: 8px;">
                    <span class="spec-label">Daños en el vehículo</span>
                    <span class="spec-value" style="font-weight: 400; line-height: 1.6; color: #334155;"><%= siniestro.danos_vehiculo %></span>
                </div>
                <% } %>
            </div>

            <%# TERCEROS %>
            <% if(siniestro.tercero_vehiculo || siniestro.tercero_seguro || siniestro.tercero_conductor) { %>
            <div class="caja-seccion">
                <h4 class="caja-titulo">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #eab308;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    Terceros Involucrados
                </h4>
                <div class="detalle-grid">
                    <div class="spec-row">
                        <span class="spec-label">Vehículo Tercero</span>
                        <span class="spec-value"><%= siniestro.tercero_vehiculo || '—' %></span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Seguro del Tercero</span>
                        <span class="spec-value"><%= siniestro.tercero_seguro || '—' %></span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Conductor Tercero</span>
                        <span class="spec-value"><%= siniestro.tercero_conductor || '—' %></span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Contacto</span>
                        <span class="spec-value"><%= siniestro.tercero_contacto || '—' %></span>
                    </div>
                </div>
            </div>
            <% } %>

            <%# ARCHIVOS ADJUNTOS %>
            <div class="caja-seccion">
                <h4 class="caja-titulo">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    Archivos y Evidencia
                </h4>
                <% 
                  const archivos = siniestro.archivos_adjuntos ? siniestro.archivos_adjuntos.split(',').filter(a => a.trim() !== '') : [];
                %>
                <% if(archivos.length > 0) { %>
                    <% archivos.forEach(archivo => { %>
                        <a href="/uploads/siniestros/<%= archivo.trim() %>" target="_blank" class="archivo-item">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <%= archivo.trim() %>
                        </a>
                    <% }) %>
                <% } else { %>
                    <p style="color: #94a3b8; font-size: 14px; margin: 0;">Sin archivos adjuntos.</p>
                <% } %>
            </div>

            <%# ACCIONES FINALES %>
<div class="acciones-bottom">
    <% if(siniestro.estado !== 'RESUELTO') { %>
        <form action="/Siniestros/<%= siniestro.id_siniestro %>/resolver" method="POST" onsubmit="return confirm('¿Cerrar este caso? El vehículo y chofer quedarán disponibles.')">
            <button type="submit" class="btn-resolver">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Cerrar Caso
            </button>
        </form>
    <% } else { %>
        <p style="color: #059669; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 6px;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Caso cerrado
        </p>
    <% } %>
</div>

        </main>
    </div>

    <script src="/js/sidebar.js"></script>
    <script>
        /* ── FIX BOTÓN HAMBURGUESA BLINDADO ── */
        document.addEventListener('DOMContentLoaded', () => {
            const topbar = document.querySelector('.topbar') || document.querySelector('.app-header');
            if (!topbar) return;
            const btnHamburguesa = topbar.querySelector('button') || document.getElementById('menu-toggle');
            const sidebar = document.getElementById('mi-sidebar-blindado');
            const overlay = document.getElementById('sb-overlay-blindado');
            if (btnHamburguesa && sidebar && overlay) {
                const nuevoBtn = btnHamburguesa.cloneNode(true);
                btnHamburguesa.parentNode.replaceChild(nuevoBtn, btnHamburguesa);
                nuevoBtn.addEventListener('click', (e) => {
                    e.preventDefault(); e.stopPropagation();
                    sidebar.classList.toggle('abierto'); overlay.classList.toggle('activo');
                });
            }
        });
    </script>
</body>
</html>
