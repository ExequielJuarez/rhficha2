<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Editar Chofer - Gestión de Flota</title>
  <link rel="stylesheet" href="/css/CargaChofer.css" />
  <link rel="stylesheet" href="/css/CargaFichaVehiculo.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── ADAPTACIÓN MÓVIL Y BOTÓN VOLVER ── */
    #mobile-back-btn {
      background-color: #f8fafc;
      color: #475569;
      border: 1px solid #cbd5e1;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: 0.2s;
      margin-bottom: 20px;
      text-decoration: none;
    }
    #mobile-back-btn:hover { background-color: #e2e8f0; color: #0f172a; }
    #mobile-back-btn svg { width: 16px; height: 16px; }

    @media (min-width: 900px) {
      #mobile-back-btn { display: none !important; }
    }

    @media (max-width: 900px) {
      .form-row { flex-direction: column !important; gap: 0 !important; }
      .acciones { flex-direction: column-reverse !important; width: 100% !important; gap: 12px !important; }
      .acciones button, .acciones a { width: 100% !important; text-align: center; padding: 14px !important; font-size: 14px !important; }
      .page-header { margin-bottom: 16px !important; }
    }
  </style>
</head>
<body>

  <%- include('./partials/sidebar') %>

  <div class="app-wrapper" id="app-wrapper">

    <%- include('./partials/topbar') %>

    <main class="main-content">

      <!-- Botón Volver Exclusivo de Celulares -->
      <a href="/Choferes" id="mobile-back-btn">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
        Volver a Choferes
      </a>

      <div class="page-header">
        <div>
          <h2 class="page-title">Editar Chofer</h2>
          <p class="page-subtitle">Modifique los datos de <%= old?.nombre || 'este' %> <%= old?.apellido || 'chofer' %>.</p>
        </div>
      </div>

      <form class="form" action="/Choferes/<%= chofer.id_chofer %>/editar" method="post" enctype="multipart/form-data">

        <section class="form-section">
          <h3>Información Básica</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Nombre</label>
              <input class="input <%= errors?.nombre ? 'input-error' : '' %>" name="nombre" type="text" placeholder="Ingrese el nombre" value="<%= old?.nombre || '' %>">
              <% if (errors?.nombre) { %><span class="error"><%= errors.nombre.msg %></span><% } %>
            </div>
  
            <div class="form-group">
              <label>Apellido</label>
              <input class="input <%= errors?.apellido ? 'input-error' : '' %>" name="apellido" type="text" placeholder="Ingrese el apellido" value="<%= old?.apellido || '' %>">
              <% if (errors?.apellido) { %><span class="error"><%= errors.apellido.msg %></span><% } %>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>DNI (No modificable)</label>
              <input class="input" name="dni" type="text" value="<%= old?.dni || '' %>" readonly style="background-color: #f1f5f9; cursor: not-allowed; color: #64748b;">
            </div>

            <div class="form-group">
              <label>Fecha de Nacimiento</label>
              <input class="input <%= errors?.fechaNacimiento ? 'input-error' : '' %>" name="fechaNacimiento" type="date" value="<%= old?.fechaNacimiento || '' %>">
              <% if (errors?.fechaNacimiento) { %><span class="error"><%= errors.fechaNacimiento.msg %></span><% } %>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Teléfono</label>
              <input class="input <%= errors?.telefono ? 'input-error' : '' %>" name="telefono" type="tel" value="<%= old?.telefono || '' %>">
              <% if (errors?.telefono) { %><span class="error"><%= errors.telefono.msg %></span><% } %>
            </div>
            <div class="form-group">
              <label>E-mail</label>
              <input class="input <%= errors?.email ? 'input-error' : '' %>" name="email" type="email" value="<%= old?.email || '' %>">
              <% if (errors?.email) { %><span class="error"><%= errors.email.msg %></span><% } %>
            </div>
          </div>

          <div class="form-group">
            <label>Dirección</label>
            <input class="input <%= errors?.direccion ? 'input-error' : '' %>" name="direccion" type="text" value="<%= old?.direccion || '' %>">
            <% if (errors?.direccion) { %><span class="error"><%= errors.direccion.msg %></span><% } %>
          </div>
        </section>

        <section class="form-section">
          <h3>Datos laborales</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Fecha de Ingreso</label>
              <input class="input <%= errors?.fechaIngreso ? 'input-error' : '' %>" name="fechaIngreso" type="date" value="<%= old?.fechaIngreso || '' %>">
              <% if (errors?.fechaIngreso) { %><span class="error"><%= errors.fechaIngreso.msg %></span><% } %>
            </div>

            <div class="form-group">
              <label>Estado</label>
              <select class="input <%= errors?.['activo-inactivo'] ? 'input-error' : '' %>" name="activo-inactivo">
                <option value="">Seleccionar</option>
                <option value="Activo"   <%= old?.['activo-inactivo'] === 'Activo'   ? 'selected' : '' %>>Activo</option>
                <option value="Inactivo" <%= old?.['activo-inactivo'] === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
              </select>
              <% if (errors?.['activo-inactivo']) { %><span class="error"><%= errors['activo-inactivo'].msg %></span><% } %>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Turno</label>
              <select name="Turno">
                <option value="">Seleccionar</option>
                <option <%= old?.Turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
                <option <%= old?.Turno === 'Tarde'  ? 'selected' : '' %>>Tarde</option>
              </select>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h3>Datos de Licencia</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Número de Licencia</label>
              <input class="input <%= errors?.numero_licencia ? 'input-error' : '' %>" name="numero_licencia" type="text" placeholder="Ingrese el número de licencia" value="<%= old?.numero_licencia || '' %>">
              <% if (errors?.numero_licencia) { %><span class="error"><%= errors.numero_licencia.msg %></span><% } %>
            </div>
            <div class="form-group">
              <label>Categoría de Licencia</label>
              <select class="input <%= errors?.categoria ? 'input-error' : '' %>" name="categoria">
                <option value="">Seleccione categoría</option>
                <option value="A"  <%= old?.categoria === 'A'  ? 'selected' : '' %>>A - Motocicletas</option>
                <option value="B1" <%= old?.categoria === 'B1' ? 'selected' : '' %>>B1 - Autos y camionetas</option>
                <option value="B2" <%= old?.categoria === 'B2' ? 'selected' : '' %>>B2 - Vehículos utilitarios</option>
                <option value="C"  <%= old?.categoria === 'C'  ? 'selected' : '' %>>C - Camiones sin acoplado</option>
                <option value="D"  <%= old?.categoria === 'D'  ? 'selected' : '' %>>D - Transporte de pasajeros</option>
                <option value="E"  <%= old?.categoria === 'E'  ? 'selected' : '' %>>E - Camiones con acoplado</option>
                <option value="G"  <%= old?.categoria === 'G'  ? 'selected' : '' %>>G - Maquinaria especial</option>
              </select>
              <% if (errors?.categoria) { %><span class="error"><%= errors.categoria.msg %></span><% } %>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Fecha de Emisión</label>
              <input class="input <%= errors?.fecha_emision ? 'input-error' : '' %>" name="fecha_emision" type="date" value="<%= old?.fecha_emision || '' %>">
              <% if (errors?.fecha_emision) { %><span class="error"><%= errors.fecha_emision.msg %></span><% } %>
            </div>
            <div class="form-group">
              <label>Vencimiento</label>
              <input class="input <%= errors?.fecha_vencimiento ? 'input-error' : '' %>" name="fecha_vencimiento" type="date" value="<%= old?.fecha_vencimiento || '' %>">
              <% if (errors?.fecha_vencimiento) { %><span class="error"><%= errors.fecha_vencimiento.msg %></span><% } %>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h3>Imágen de Perfil (Opcional al editar)</h3>

          <div class="upload-box">
            <label for="imagen">Subir nueva imagen (Reemplazará la actual)</label>
            <input type="file" id="imagen" name="imagen">
          </div>

          <div id="preview">
            <p style="color: #64748b; font-size: 0.9em; margin-top: 10px;">Si no subís un archivo nuevo, se mantendrá la imagen que ya estaba guardada.</p>
          </div>
        </section>

        <div class="acciones">
          <a href="/Choferes" class="boton-secundario">Cancelar y Volver</a>
          <button type="submit" class="boton-primario">Actualizar Chofer</button>
        </div>

      </form>

    </main>

    <footer class="app-footer">
      <p class="app-footer__copy">* Campos obligatorios &nbsp;|&nbsp; &copy; 2025 &mdash; Ficha Tecnica</p>
    </footer>

  </div>

  <script src="/js/sidebar.js"></script>
  <script>
    /* ── FIX BOTÓN HAMBURGUESA BLINDADO ── */
    document.addEventListener('DOMContentLoaded', () => {
      const topbar = document.querySelector('.topbar') || document.querySelector('.app-header');
      if (!topbar) return;
      const btnHamburguesa = topbar.querySelector('button') || document.getElementById('menu-toggle');
      const sidebar = document.getElementById('mi-sidebar-blindado');
      const overlay = document.getElementById('sb-overlay-blindado');
      if (btnHamburguesa && sidebar && overlay) {
        const nuevoBtn = btnHamburguesa.cloneNode(true);
        btnHamburguesa.parentNode.replaceChild(nuevoBtn, btnHamburguesa);
        nuevoBtn.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          sidebar.classList.toggle('abierto'); overlay.classList.toggle('activo');
        });
      }
    });

    // Limpiar clases de error al escribir
    document.querySelectorAll('.input-error').forEach(input => {
      input.addEventListener('input', function() {
        this.classList.remove('input-error');
        const errorSpan = this.nextElementSibling;
        if(errorSpan && errorSpan.classList.contains('error')) {
          errorSpan.style.display = 'none';
        }
      });
    });
  </script>

</body>
</html>