<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Plantilla de Choferes - Gestión de Flota</title>
  <link rel="stylesheet" href="/css/ListadoVehiculos.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    @media print {
      #sidebar, .app-header, .vehicle-list-panel, .topbar { display: none !important; }
      .app-wrapper { margin: 0 !important; padding: 0 !important; }
      .vehicle-detail { width: 100% !important; padding: 0 !important; background: #fff !important; }
      .vehicle-profile { box-shadow: none !important; border: 1px solid #000 !important; }
    }
    .detail-chofer-content { display: none; }
    .detail-chofer-content.active { display: flex; flex-direction: column; gap: 24px; }

    /* ── LÓGICA RESPONSIVE Y BOTÓN VOLVER (CELULARES) ── */
    #detail-back-btn {
      background-color: #f8fafc;
      color: #475569;
      border: 1px solid #cbd5e1;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: 0.2s;
      margin-bottom: 20px;
    }
    #detail-back-btn:hover { background-color: #e2e8f0; color: #0f172a; }
    #detail-back-btn svg { width: 16px; height: 16px; }

    /* Ocultar botón volver en PC */
    @media (min-width: 900px) {
      #detail-back-btn { display: none !important; }
    }

    /* Comportamiento de las dos columnas en Celular */
    @media (max-width: 900px) {
      .main-content { flex-direction: column !important; }
      .vehicle-list-panel { width: 100% !important; border-right: none !important; }
      .vehicle-detail { display: none; width: 100% !important; }
      
      .vehicle-list-panel--hidden { display: none !important; }
      .vehicle-detail--visible { display: block !important; }
    }
  </style>
</head>
<body>

  <%- include('./partials/sidebar') %>

  <div class="app-wrapper" id="app-wrapper">

    <%- include('./partials/topbar') %>

    <%
      const getEstadoClass = (est) => est === 'Activo' ? 'badge--success' : 'badge--danger';
      
      const checkVencimiento = (fechaStr) => {
         if (!fechaStr) return { class: 'badge--danger', colorText: '#991b1b', text: 'Sin Licencia', diff: -999, format: '—' };
         const d = new Date(fechaStr);
         const format = `${String(d.getUTCDate()).padStart(2,'0')}/${String(d.getUTCMonth()+1).padStart(2,'0')}/${d.getUTCFullYear()}`;
         const hoy = new Date(); hoy.setHours(0,0,0,0);
         const diff = Math.ceil((d - hoy)/(1000*60*60*24));
         
         let cls = 'badge--success';
         let colorText = '#065f46';
         if (diff <= 30) { cls = 'badge--danger'; colorText = '#991b1b'; }
         else if (diff <= 90) { cls = 'badge--warning'; colorText = '#92400e'; }
         
         return { class: cls, colorText, diff, format, dateObj: d };
      };
    %>

    <main class="main-content" id="main-content">

      <section class="vehicle-list-panel" id="vehicle-list-panel" style="width: 340px;">
        <div class="vehicle-list-panel__top" style="display: flex; justify-content: space-between; align-items: center;">
          <h2 class="vehicle-list-panel__title">Plantilla de Choferes</h2>
          <a href="/Choferes/Carga" style="background-color: #2563eb; color: white; border-radius: 6px; padding: 6px 12px; font-size: 12px; font-weight: 700; text-decoration: none; display: flex; align-items: center; transition: 0.2s;">
            + Nuevo
          </a>
        </div>

        <div class="vehicle-list-panel__search-bar" style="flex-direction: column; align-items: stretch; gap: 10px;">
          <input class="vehicle-list-panel__search-input" type="search" placeholder="Buscar por DNI, nombre..." id="searchInput" />
          
          <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; cursor: pointer;">
            <summary style="font-size: 12px; font-weight: 700; color: #475569; outline: none;">Filtros Avanzados</summary>
            <form method="GET" action="/Choferes" style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
              <select name="categoriaLicencia" style="width: 100%; padding: 6px; font-size: 12px; border-radius: 4px; border: 1px solid #cbd5e1;">
                <option value="">Todas las Categorías</option>
                <option value="A">A - Motocicletas</option>
                <option value="B1">B1 - Autos y camionetas</option>
                <option value="C">C - Camiones sin acoplado</option>
                <option value="D">D - Transporte pasajeros</option>
                <option value="E">E - Camiones con acoplado</option>
                <option value="G">G - Maquinaria especial</option>
              </select>
              <select name="estado" style="width: 100%; padding: 6px; font-size: 12px; border-radius: 4px; border: 1px solid #cbd5e1;">
                <option value="">Cualquier Estado</option>
                <option value="Activo">Activos</option>
                <option value="Inactivo">Inactivos</option>
              </select>
              <div style="display: flex; gap: 5px;">
                <button type="submit" style="flex: 1; background: #0f172a; color: white; padding: 6px; font-size: 11px; border-radius: 4px; font-weight: 700;">Filtrar</button>
                <a href="/Choferes" style="flex: 1; background: #e2e8f0; color: #475569; padding: 6px; font-size: 11px; border-radius: 4px; font-weight: 700; text-align: center; text-decoration: none;">Limpiar</a>
              </div>
            </form>
          </details>
        </div>

        <ul class="vehicle-list" id="choferList">
          <% if (choferes && choferes.length > 0) { %>
            <% choferes.forEach(chofer => { %>
              <% 
                const lic = chofer.licencias.length > 0 ? chofer.licencias[0] : null;
                const vInfo = checkVencimiento(lic ? lic.fecha_vencimiento : null);
              %>
              <li class="vehicle-card chofer-item" data-id="<%= chofer.id_chofer %>" style="padding: 12px 16px;">
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
                  <span class="vehicle-card__plate" style="font-size: 14px;"><%= chofer.nombre %> <%= chofer.apellido %></span>
                  <span class="badge <%= getEstadoClass(chofer.estado) %>" style="font-size: 10px; padding: 2px 6px;"><%= chofer.estado %></span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                  <span class="vehicle-card__model" style="font-size: 12px; margin: 0;">DNI: <%= chofer.dni %></span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span class="badge <%= vInfo.class %>" style="font-size: 9px; padding: 2px 6px;">
                    Lic. <%= lic ? lic.categoria : 'N/A' %>
                  </span>
                  <span style="font-size: 11px; color: <%= vInfo.colorText %>; font-weight: 600;">Venc: <%= vInfo.format %></span>
                </div>
              </li>
            <% }) %>
          <% } else { %>
            <div style="padding: 30px 20px; text-align: center; color: #64748b;">
              <p style="font-weight: 500;">No hay choferes registrados.</p>
            </div>
          <% } %>
        </ul>

        <div class="vehicle-list-panel__footer" style="padding: 12px; display: flex; flex-direction: column; gap: 8px;">
          <span style="font-size: 11px; color: #64748b; font-weight: 600;">
            Mostrando pág. <%= paginaActual %> de <%= totalPaginas %> (<%= totalRegistros %> totales)
          </span>
          <div class="pagination">
            <% const base = '/Choferes?' + (queryString ? queryString + '&' : ''); %>
            <% if (paginaActual > 1) { %>
                <a href="<%= base %>pagina=<%= paginaActual - 1 %>" class="pagination__btn">«</a>
            <% } else { %>
                <button class="pagination__btn" disabled>«</button>
            <% } %>
            
            <button class="pagination__btn pagination__btn--active"><%= paginaActual %></button>
            
            <% if (paginaActual < totalPaginas) { %>
                <a href="<%= base %>pagina=<%= paginaActual + 1 %>" class="pagination__btn">»</a>
            <% } else { %>
                <button class="pagination__btn" disabled>»</button>
            <% } %>
          </div>
        </div>
      </section>

      <section class="vehicle-detail" id="vehicle-detail">
        
        <nav aria-label="Navegación móvil" style="padding: 20px 24px 0 24px;">
          <button id="detail-back-btn">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
            Volver al listado
          </button>
        </nav>

        <div id="empty-state" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh; color: #94a3b8;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width: 60px; height: 60px; margin-bottom: 16px; opacity: 0.5;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <p>Hacé clic en un chofer de la lista para ver su ficha.</p>
        </div>

        <% if (choferes && choferes.length > 0) { %>
          <% choferes.forEach(chofer => { %>
            <% 
              const lic = chofer.licencias.length > 0 ? chofer.licencias[0] : null;
              const vInfo = checkVencimiento(lic ? lic.fecha_vencimiento : null);
              const asig = chofer.asignaciones.length > 0 ? chofer.asignaciones[0] : null;
            %>
            <div class="detail-chofer-content" id="detail-<%= chofer.id_chofer %>">
              
              <article class="vehicle-profile" style="padding: 24px; position: relative;">
                
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 20px;">
                  <div style="display: flex; align-items: center; gap: 16px;">
                    <% if (lic && lic.imagen) { %>
                      <img src="/img/licencias/<%= lic.imagen %>" alt="Foto Chofer" style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0;">
                    <% } else { %>
                      <div style="width: 60px; height: 60px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; color: #94a3b8;">
                        <%= chofer.nombre.charAt(0) %><%= chofer.apellido.charAt(0) %>
                      </div>
                    <% } %>
                    <div>
                      <h2 style="margin:0; font-size: 24px; font-weight: 800; color: #0f172a;"><%= chofer.nombre %> <%= chofer.apellido %></h2>
                      <span class="badge <%= getEstadoClass(chofer.estado) %>" style="font-size: 11px; margin-top: 4px;"><%= chofer.estado %></span>
                    </div>
                  </div>

                  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                    <button onclick="window.print()" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 8px 14px; font-size: 12px; font-weight: 700; border-radius: 6px; display: flex; align-items: center; transition: 0.2s;">
                      Imprimir
                    </button>
                    <a href="/Choferes/<%= chofer.id_chofer %>/editar" style="background-color: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; padding: 8px 14px; font-size: 12px; font-weight: 700; border-radius: 6px; text-decoration: none;">
                      Editar
                    </a>
                    
                    <% if (chofer.estado === 'Activo') { %>
                      <form method="POST" action="/Choferes/<%= chofer.id_chofer %>/desactivar" style="margin:0;" onsubmit="return confirm('¿Desactivar a este chofer?');">
                        <button type="submit" style="background-color: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 8px 14px; font-size: 12px; font-weight: 700; border-radius: 6px;">Desactivar</button>
                      </form>
                    <% } else { %>
                      <form method="POST" action="/Choferes/<%= chofer.id_chofer %>/activar" style="margin:0;" onsubmit="return confirm('¿Activar a este chofer?');">
                        <button type="submit" style="background-color: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; padding: 8px 14px; font-size: 12px; font-weight: 700; border-radius: 6px;">Activar</button>
                      </form>
                    <% } %>
                  </div>
                </div>

                <div class="vehicle-profile__specs" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px;">
                  <dl class="vehicle-profile__spec-group">
                    <div class="vehicle-profile__spec-row">
                      <dt class="vehicle-profile__spec-label">Documento (DNI)</dt>
                      <dd class="vehicle-profile__spec-value" style="font-family: var(--font-mono); font-size: 15px;"><%= chofer.dni %></dd>
                    </div>
                    <div class="vehicle-profile__spec-row">
                      <dt class="vehicle-profile__spec-label">Teléfono de Contacto</dt>
                      <dd class="vehicle-profile__spec-value"><%= chofer.telefono || 'No registrado' %></dd>
                    </div>
                  </dl>
                  <dl class="vehicle-profile__spec-group">
                    <div class="vehicle-profile__spec-row">
                      <dt class="vehicle-profile__spec-label">N° Licencia</dt>
                      <dd class="vehicle-profile__spec-value" style="font-family: var(--font-mono);"><%= lic ? lic.numero : '—' %></dd>
                    </div>
                    <div class="vehicle-profile__spec-row">
                      <dt class="vehicle-profile__spec-label">Categoría(s)</dt>
                      <dd class="vehicle-profile__spec-value" style="font-weight: 800; color: #2563eb;"><%= lic ? lic.categoria : '—' %></dd>
                    </div>
                  </dl>
                </div>
              </article>

              <div class="detail-columns">
                <div class="detail-main-column">
                  <section class="data-card">
                    <header class="data-card__header">
                      <svg class="data-card__icon" viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3z"/></svg>
                      <h3 class="data-card__title">Vehículo Asignado Actual</h3>
                    </header>
                    <div style="padding: 20px;">
                      <% if (asig) { %>
                        <div style="display: flex; align-items: center; gap: 16px;">
                          <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 16px; text-align: center;">
                            <span style="display: block; font-size: 11px; font-weight: 700; color: #64748b; margin-bottom: 4px;">PATENTE</span>
                            <span style="font-family: var(--font-mono); font-size: 18px; font-weight: 800; color: #0f172a;"><%= asig.vehiculo.patente %></span>
                          </div>
                          <div>
                            <span style="display: block; font-size: 14px; font-weight: 700; color: #0f172a;"><%= asig.vehiculo.marca %> <%= asig.vehiculo.modelo %></span>
                            <span style="display: block; font-size: 12px; color: #64748b;">Asignado el: <%= new Date(asig.fecha_asignacion).toLocaleDateString('es-AR') %></span>
                          </div>
                        </div>
                      <% } else { %>
                        <p style="color: #64748b; font-size: 13px;">No tiene ningún vehículo asignado actualmente.</p>
                      <% } %>
                    </div>
                  </section>
                </div>

                <aside class="detail-side-column">
                  <section class="alerts-card">
                    <header class="data-card__header">
                      <svg class="data-card__icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"/></svg>
                      <h3 class="data-card__title">Estado de Licencia</h3>
                    </header>
                    <ul class="alert-list">
                      <li class="alert-item <%= vInfo.class === 'badge--danger' ? 'alert-item--danger' : (vInfo.class === 'badge--warning' ? 'alert-item--warning' : '') %>" style="<%= vInfo.class === 'badge--success' ? 'background: #f8fafc;' : '' %>">
                        <div style="flex:1;">
                          <span class="alert-item__label" style="color: <%= vInfo.colorText %>;">
                            <%= vInfo.diff < 0 ? 'Licencia Vencida' : (vInfo.diff <= 90 ? 'Próxima a vencer' : 'Licencia Vigente') %>
                          </span>
                          <span class="alert-item__desc">
                            Vencimiento: <%= vInfo.format %>
                            <% if(vInfo.diff > 0) { %> (<%= vInfo.diff %> días restantes) <% } %>
                          </span>
                        </div>
                      </li>
                    </ul>
                  </section>
                </aside>
              </div>

            </div>
          <% }) %>
        <% } %>

      </section>
    </main>

  </div>

  <script src="/js/sidebar.js"></script>
  <script>
    /* ── FIX BOTÓN HAMBURGUESA BLINDADO ── */
    document.addEventListener('DOMContentLoaded', () => {
      const topbar = document.querySelector('.topbar') || document.querySelector('.app-header');
      if (!topbar) return;
      const btnHamburguesa = topbar.querySelector('button') || document.getElementById('menu-toggle');
      const sidebar = document.getElementById('mi-sidebar-blindado');
      const overlay = document.getElementById('sb-overlay-blindado');
      if (btnHamburguesa && sidebar && overlay) {
        const nuevoBtn = btnHamburguesa.cloneNode(true);
        btnHamburguesa.parentNode.replaceChild(nuevoBtn, btnHamburguesa);
        nuevoBtn.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          sidebar.classList.toggle('abierto'); overlay.classList.toggle('activo');
        });
      }
    });

    // LÓGICA FRONT-END PARA MASTER-DETAIL Y MOBILE RESPONSIVE
    const listPanel   = document.getElementById('vehicle-list-panel');
    const detailPanel = document.getElementById('vehicle-detail');
    const backBtn     = document.getElementById('detail-back-btn');
    const choferItems = document.querySelectorAll('.chofer-item');
    const emptyState  = document.getElementById('empty-state');
    const allDetails  = document.querySelectorAll('.detail-chofer-content');

    function isMobileView() { return window.innerWidth < 900; }

    choferItems.forEach(item => {
      item.addEventListener('click', function() {
        choferItems.forEach(c => c.classList.remove('vehicle-card--active'));
        this.classList.add('vehicle-card--active');

        if (emptyState) emptyState.style.display = 'none';
        allDetails.forEach(d => d.classList.remove('active'));

        const targetId = 'detail-' + this.dataset.id;
        const targetElement = document.getElementById(targetId);
        if (targetElement) targetElement.classList.add('active');

        if (isMobileView()) {
          listPanel.classList.add('vehicle-list-panel--hidden');
          detailPanel.classList.add('vehicle-detail--visible');
          detailPanel.scrollTop = 0;
        }
      });
    });

    if (backBtn) {
      backBtn.addEventListener('click', function () {
        listPanel.classList.remove('vehicle-list-panel--hidden');
        detailPanel.classList.remove('vehicle-detail--visible');
      });
    }

    window.addEventListener('resize', function () {
      if (!isMobileView()) {
        listPanel.classList.remove('vehicle-list-panel--hidden');
        detailPanel.classList.remove('vehicle-detail--visible');
      }
    });

    // BUSCADOR EN TIEMPO REAL
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase().trim();
        choferItems.forEach(item => {
          const text = item.textContent.toLowerCase();
          item.style.display = text.includes(term) ? '' : 'none';
        });
      });
    }
  </script>

</body>
</html>