<script>
  // ── SCRIPT TOTALMENTE AISLADO (Para evitar choques con tus JS viejos) ──
  (function() {
      try {
          const urlActual = window.location.pathname.toLowerCase();
          const enlaces = document.querySelectorAll('#mi-sidebar-blindado a[href]:not([href="#"])');
          
          let mejorEnlace = null;
          let maxCoincidencia = 0;
          
          enlaces.forEach(enlace => {
              const href = enlace.getAttribute('href').toLowerCase();
              if (urlActual.startsWith(href) && href.length > maxCoincidencia) {
                  maxCoincidencia = href.length;
                  mejorEnlace = enlace;
              }
          });
          
          if (mejorEnlace) {
              mejorEnlace.classList.add('activo');
              // Si es un submenú, abrir al padre
              if (mejorEnlace.classList.contains('sb-sub-link')) {
                  const liPadre = mejorEnlace.closest('.sb-li');
                  if (liPadre) {
                      liPadre.classList.add('abierto');
                      const linkPadre = liPadre.querySelector('.sb-link');
                      if (linkPadre) linkPadre.classList.add('activo');
                  }
              }
          }

          // Lógica menú móvil
          const btnMenu = document.getElementById('menu-toggle');
          if (btnMenu) {
              btnMenu.addEventListener('click', function(e) {
                  e.preventDefault();
                  document.getElementById('mi-sidebar-blindado').classList.add('abierto');
                  document.getElementById('sb-overlay-blindado').classList.add('activo');
              });
          }
      } catch (err) {
          console.log("Error pintando el menú:", err);
      }
  })();
</script>