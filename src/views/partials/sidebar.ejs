<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

  /* ── 1. ESTRUCTURA BLINDADA (Ignora tus CSS viejos) ── */
  body .app-wrapper { margin-left: 280px !important; width: calc(100% - 280px) !important; transition: 0.3s ease !important; }
  
  #mi-sidebar-blindado {
    position: fixed !important; top: 0 !important; left: 0 !important; bottom: 0 !important; z-index: 9999 !important;
    background-color: #0f172a !important; /* Fondo azul noche */
    font-family: 'DM Sans', sans-serif !important;
    width: 280px !important; display: flex !important; flex-direction: column !important;
    border-right: 1px solid #1e293b !important;
    overflow: hidden !important; transition: transform 0.3s ease !important;
  }

  /* ── 2. LOGO Y MARCA (HEADER FIJO, NO SCROLLA) ── */
  /* ── 2. LOGO Y MARCA (HEADER FIJO, NO SCROLLA) ── */
  .sb-header {
    padding: 24px !important;
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    border-bottom: 1px solid #1e293b !important;
    margin-bottom: 10px !important;
    flex-shrink: 0 !important;
    
    /* ── FIX DEFINITIVO: STICKY BLINDADO ── */
    position: sticky !important;
    top: 0 !important;
    background-color: #0f172a !important; /* Mismo azul noche del menú */
    z-index: 50 !important;
  }
  .sb-logo-box { width: 44px !important; height: 44px !important; background: #ffffff !important; border-radius: 10px !important; padding: 4px !important; display: flex; align-items: center; justify-content: center; }
  .sb-logo-box img { width: 100% !important; height: auto !important; }
  .sb-title-box { display: flex !important; flex-direction: column !important; }
  .sb-title { color: #ffffff !important; font-weight: 800 !important; font-size: 17px !important; letter-spacing: -0.02em !important; margin: 0 !important; line-height: 1.2 !important; }
  .sb-subtitle { color: #38bdf8 !important; font-size: 11px !important; font-weight: 800 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; margin: 0 !important; }
  
  /* ── 3. NAVEGACIÓN PRINCIPAL ── */
  .sb-nav { padding: 0 16px 24px 16px !important; }
  .sb-label { display: block !important; padding: 0 12px !important; font-size: 11px !important; font-weight: 800 !important; color: #475569 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; margin-bottom: 16px !important; }
  .sb-ul { list-style: none !important; padding: 0 !important; margin: 0 !important; }
  .sb-li { margin-bottom: 6px !important; }
  
  /* Botón Principal (Títulos) */
  .sb-link { 
    display: flex !important; align-items: center !important; 
    padding: 12px 14px !important; 
    color: #e2e8f0 !important; /* Color principal: Blanco Humo */
    text-decoration: none !important; 
    border-radius: 8px !important; 
    font-weight: 600 !important; 
    font-size: 15px !important; /* Tipografía más grande */
    transition: all 0.2s ease !important; 
    cursor: pointer !important;
  }
  .sb-link:hover { background-color: #1e293b !important; color: #ffffff !important; }
  
  /* Íconos de Títulos */
  .sb-icon { width: 22px !important; height: 22px !important; margin-right: 14px !important; flex-shrink: 0 !important; color: #64748b !important; transition: color 0.2s !important; }
  .sb-link:hover .sb-icon { color: #cbd5e1 !important; }
  
  /* Flechita */
  .sb-chevron { width: 16px !important; height: 16px !important; margin-left: auto !important; transition: transform 0.3s ease !important; opacity: 0.5 !important; }
  .sb-li.abierto .sb-chevron { transform: rotate(180deg) !important; opacity: 1 !important; color: #38bdf8 !important; }
  
  /* ── 4. SUBMENÚS (Alineación Perfecta) ── */
  .sb-submenu { list-style: none !important; padding: 0 !important; margin: 4px 0 8px 0 !important; display: none !important; }
  .sb-li.abierto .sb-submenu { display: block !important; }
  
  /* Opciones Desplegables */
  .sb-sub-link { 
    display: block !important; 
    /* LA MAGIA DE LA ALINEACIÓN: 14px (padding) + 22px (icono) + 14px (margen del icono) = 50px */
    padding: 10px 14px 10px 50px !important; 
    color: #94a3b8 !important; /* Color secundario: Gris Azulado */
    text-decoration: none !important; 
    font-size: 14px !important; 
    font-weight: 500 !important;
    border-radius: 8px !important; 
    transition: all 0.2s ease !important; 
  }
  .sb-sub-link:hover { color: #38bdf8 !important; background-color: #1e293b !important; }

  /* ── 5. ESTADOS ACTIVOS (Pintados) ── */
  .sb-link.activo { background-color: rgba(56, 189, 248, 0.1) !important; color: #38bdf8 !important; font-weight: 700 !important; }
  .sb-link.activo .sb-icon { color: #38bdf8 !important; }
  .sb-sub-link.activo { color: #38bdf8 !important; font-weight: 700 !important; background-color: rgba(56, 189, 248, 0.05) !important; }

  /* ── 6. RESPONSIVE (CELULARES) ── */
  #sb-overlay-blindado { position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; background: rgba(0,0,0,0.5) !important; z-index: 9998 !important; display: none !important; }
  @media (max-width: 900px) {
    body .app-wrapper { margin-left: 0 !important; width: 100% !important; }
    #mi-sidebar-blindado { transform: translateX(-100%) !important; }
    #mi-sidebar-blindado.abierto { transform: translateX(0) !important; }
    #sb-overlay-blindado.activo { display: block !important; }
  }
</style>

<%
  const user = (typeof usuarioLogueado !== 'undefined') ? usuarioLogueado : null;
  const hasPerm = (permiso) => {
      if (!user) return true; 
      if (user.rol === 'Administrador') return true; 
      if (!user.permisos) return false;
      return user.permisos.includes(permiso);
  };
%>

