<style>
  .visor { position:fixed; inset:0; z-index:9999; background:rgba(15,23,42,.8); display:none; align-items:center; justify-content:center; padding:20px; }
  .visor--abierto { display:flex; }
  .visor__caja { background:#fff; border-radius:12px; width:min(980px,100%); height:min(90vh,820px); display:flex; flex-direction:column; overflow:hidden; }
  .visor__barra { display:flex; align-items:center; gap:10px; padding:10px 14px; border-bottom:1px solid #e2e8f0; }
  .visor__nombre { flex:1; font-weight:700; font-size:14px; color:#0f172a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .visor__barra a, .visor__barra button { border:1px solid #cbd5e1; background:#f8fafc; color:#0f172a; border-radius:8px; padding:6px 12px; font-size:12px; font-weight:700; text-decoration:none; cursor:pointer; }
  .visor__contenido { flex:1; display:flex; align-items:center; justify-content:center; background:#f1f5f9; overflow:auto; }
  .visor__contenido img { max-width:100%; max-height:100%; object-fit:contain; }
  .visor__contenido iframe { width:100%; height:100%; border:0; }
</style>
<div class="visor" id="visor" aria-hidden="true">
  <div class="visor__caja" role="dialog" aria-label="Visor de documento">
    <div class="visor__barra">
      <span class="visor__nombre" id="visor-nombre"></span>
      <a id="visor-abrir" href="#" target="_blank" rel="noopener">Abrir en pestaña</a>
      <a id="visor-descargar" href="#">Descargar</a>
      <button type="button" id="visor-cerrar">Cerrar ✕</button>
    </div>
    <div class="visor__contenido" id="visor-contenido"></div>
  </div>
</div>
<script src="/js/visor.js"></script>
