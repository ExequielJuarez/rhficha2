<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ajustes de Sistema - Gestión Industrial</title>
  <link rel="stylesheet" href="/css/ListadoVehiculos.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
    .settings-card { background: var(--color-surface); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); border: 1px solid var(--color-border); }
    .settings-card h3 { margin-top: 0; color: var(--color-primary); border-bottom: 1px solid var(--color-border-light); padding-bottom: 12px; margin-bottom: 20px; font-size: 16px; font-weight: 800; }
    .list-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--color-border-light); font-size: 14px; font-weight: 600; color: var(--color-text-secondary); }
    .list-item:last-child { border-bottom: none; }
    .btn-add { background: var(--color-primary); color: white; border: none; padding: 10px 16px; border-radius: var(--radius-md); font-weight: 700; font-size: 13px; cursor: pointer; transition: 0.2s; white-space: nowrap; }
    .btn-add:hover { background: var(--color-primary-hover); }
    .input-add { flex: 1; padding: 10px 14px; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 13px; outline: none; transition: 0.2s; font-family: var(--font-sans); color: var(--color-text-primary); }
    .input-add:focus { border-color: var(--color-blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    .form-add { display: flex; gap: 10px; margin-top: 20px; }
    .btn-delete { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 6px 12px; border-radius: var(--radius-md); font-size: 12px; font-weight: 800; cursor: pointer; transition: 0.2s; }
    .btn-delete:hover { background: #fee2e2; }

    /* ── ADAPTACIÓN MÓVIL ── */
    @media (max-width: 900px) {
      .settings-grid { grid-template-columns: 1fr !important; }
      .form-add { flex-direction: column; }
      .btn-add { width: 100%; text-align: center; padding: 14px; font-size: 14px; }
    }
  </style>
</head>
<body>

  <%- include('./partials/sidebar') %>

  <div class="app-wrapper" id="app-wrapper">

    <%- include('./partials/topbar') %>

    <main class="main-content" style="display: block; overflow-y: auto; padding: 40px; max-width: 1100px; margin: 0 auto;">

      <div class="page-header">
        <h2 class="page-title">Ajustes Generales</h2>
        <p class="page-subtitle">Administrá los sectores y el personal autorizado para préstamos de herramientas.</p>
      </div>

      <div class="settings-grid">
        
        <div class="settings-card">
          <h3>Sectores Destino</h3>
          <div style="max-height: 250px; overflow-y: auto; padding-right: 10px; margin-bottom: 10px;">
            <% if (typeof sectores !== 'undefined' && sectores && sectores.length > 0) { %>
              <% sectores.forEach(s => { %>
                <div class="list-item">
                  <span><%= s.nombre %></span>
                  <form action="/Tools/Ajustes/Sectores/Eliminar/<%= s.id_sector %>" method="POST" style="margin:0;">
                    <button type="submit" class="btn-delete" title="Eliminar Sector">X</button>
                  </form>
                </div>
              <% }) %>
            <% } else { %>
              <p style="color: var(--color-text-muted); font-size: 13px; text-align: center; padding: 10px 0;">No hay sectores registrados.</p>
            <% } %>
          </div>
          <form action="/Tools/Ajustes/Sectores" method="POST" class="form-add">
            <input type="text" name="nombre" class="input-add" placeholder="Ej: Mantenimiento Sur..." required>
            <button type="submit" class="btn-add">+ Añadir Sector</button>
          </form>
        </div>

        <div class="settings-card">
          <h3>Operarios Autorizados</h3>
          <div style="max-height: 250px; overflow-y: auto; padding-right: 10px; margin-bottom: 10px;">
            <% if (typeof operarios !== 'undefined' && operarios && operarios.length > 0) { %>
              <% operarios.forEach(o => { %>
                <div class="list-item">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-weight: 700; color: var(--color-text-primary);"><%= o.nombre %></span>
                  </div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="badge <%= o.estado === 'Activo' ? 'badge--success' : 'badge--danger' %>" style="font-size: 10px; padding: 2px 6px;"><%= o.estado %></span>
                    <form action="/Tools/Ajustes/Operarios/Eliminar/<%= o.id_operario %>" method="POST" style="margin:0;">
                      <button type="submit" class="btn-delete" title="Eliminar Operario">X</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p style="color: var(--color-text-muted); font-size: 13px; text-align: center; padding: 10px 0;">No hay operarios registrados.</p>
            <% } %>
          </div>
          <form action="/Tools/Ajustes/Operarios" method="POST" class="form-add">
            <input type="text" name="nombre" class="input-add" placeholder="Ej: Luis Gómez..." required>
            <button type="submit" class="btn-add">+ Añadir Operario</button>
          </form>
        </div>

      </div>
    </main>
  </div>

  <script src="/js/sidebar.js"></script>
  <script>
    /* ── FIX BOTÓN HAMBURGUESA BLINDADO ── */
    document.addEventListener('DOMContentLoaded', () => {
      const topbar = document.querySelector('.topbar') || document.querySelector('.app-header');
      if (!topbar) return;
      const btnHamburguesa = topbar.querySelector('button') || document.getElementById('menu-toggle');
      const sidebar = document.getElementById('mi-sidebar-blindado');
      const overlay = document.getElementById('sb-overlay-blindado');
      if (btnHamburguesa && sidebar && overlay) {
        const nuevoBtn = btnHamburguesa.cloneNode(true);
        btnHamburguesa.parentNode.replaceChild(nuevoBtn, btnHamburguesa);
        nuevoBtn.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          sidebar.classList.toggle('abierto'); overlay.classList.toggle('activo');
        });
      }
    });
  </script>
</body>
</html>