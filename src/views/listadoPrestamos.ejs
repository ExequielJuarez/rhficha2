<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Historial de Préstamos - Gestión Industrial</title>
  <link rel="stylesheet" href="/css/ListadoVehiculos.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

  <style>
    .filtro-container { background: var(--color-surface); padding: 20px; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); margin-bottom: 24px; display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; border: 1px solid var(--color-border);}
    .filtro-group { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 180px; }
    .filtro-group label { font-size: 11px; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;}
    .filtro-input { padding: 10px 14px; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-family: var(--font-sans); font-size: 13px; color: var(--color-text-primary); outline: none; transition: 0.2s; background: white;}
    .filtro-input:focus { border-color: var(--color-blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    
    .btn-filtrar { background-color: #0f172a; color: white; padding: 10px 24px; border-radius: var(--radius-md); font-weight: 700; font-size: 13px; border: none; cursor: pointer; height: 42px; transition: 0.2s; white-space: nowrap;}
    .btn-filtrar:hover { background-color: #1e293b; }
    .btn-limpiar { background-color: var(--color-bg); color: var(--color-text-secondary); padding: 10px 20px; border-radius: var(--radius-md); font-weight: 700; font-size: 13px; border: 1px solid var(--color-border); cursor: pointer; height: 42px; transition: 0.2s; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;}
    .btn-limpiar:hover { background-color: #e2e8f0; color: var(--color-primary);}

    /* ── ADAPTACIÓN MÓVIL Y BOTÓN VOLVER ── */
    #mobile-back-btn {
      background-color: #f8fafc;
      color: #475569;
      border: 1px solid #cbd5e1;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: 0.2s;
      margin-bottom: 20px;
      text-decoration: none;
    }
    #mobile-back-btn:hover { background-color: #e2e8f0; color: #0f172a; }
    #mobile-back-btn svg { width: 16px; height: 16px; }

    @media (min-width: 900px) {
      #mobile-back-btn { display: none !important; }
    }

    @media (max-width: 900px) {
      .filtro-container { flex-direction: column; align-items: stretch; }
      .filtro-group { width: 100%; }
      .botones-filtro { display: flex; flex-direction: column; width: 100%; gap: 10px; margin-top: 10px; }
      .botones-filtro button, .botones-filtro a { width: 100%; height: auto; padding: 12px; }
      
      /* Para que la tabla se pueda deslizar con el dedo en vez de achicarse */
      .data-table-wrapper { overflow-x: auto !important; -webkit-overflow-scrolling: touch; border-radius: 8px; border: 1px solid var(--color-border-light); }
      .data-table { min-width: 800px; }
      
      .header-actions { flex-direction: column; align-items: flex-start; gap: 10px; }
      #btn-exportar { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

  <%- include('./partials/sidebar') %>

  <div class="app-wrapper" id="app-wrapper">

    <%- include('./partials/topbar') %>

    <main class="main-content" style="display: block; overflow-y: auto; padding: 40px; max-width: 1200px; margin: 0 auto;">

      <a href="/Tools" id="mobile-back-btn">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
        Volver a Inventario
      </a>

      <div class="page-header header-actions" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h2 class="page-title">Historial General de Préstamos</h2>
          <p class="page-subtitle">Monitoreo de movimientos de herramientas del pañol a los diferentes sectores.</p>
        </div>
        <button id="btn-exportar" style="background-color: #0f172a; color: white; border: none; padding: 10px 16px; font-size: 13px; font-weight: 700; border-radius: 8px; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 8px;">
          <svg viewBox="0 0 20 20" fill="currentColor" style="width: 16px; height: 16px;"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          Exportar a Excel
        </button>
      </div>

      <div class="filtro-container">
        <div class="filtro-group">
          <label>Buscar (Código, Operario...)</label>
          <input type="text" id="filtro-texto" class="filtro-input" placeholder="Escriba para filtrar...">
        </div>
        <div class="filtro-group">
          <label>Estado del Préstamo</label>
          <select id="filtro-estado" class="filtro-input">
            <option value="">Todos los estados</option>
            <option value="Activo">Activo (En calle)</option>
            <option value="Devuelto">Devuelto (En pañol)</option>
            <option value="Devuelto con daño">Devuelto con daño</option>
          </select>
        </div>
        <div class="filtro-group">
          <label>Fecha Salida (Desde)</label>
          <input type="date" id="filtro-fecha" class="filtro-input">
        </div>
        <div class="botones-filtro" style="display: flex; gap: 10px;">
          <button class="btn-limpiar" id="btn-limpiar">Restablecer</button>
        </div>
      </div>

      <div class="data-card">
        <div class="data-table-wrapper">
          <table class="data-table">
            <thead class="data-table__head">
              <tr>
                <th class="data-table__th">Herramienta</th>
                <th class="data-table__th">Operario / Responsable</th>
                <th class="data-table__th">Sector Destino</th>
                <th class="data-table__th">Fecha Salida</th>
                <th class="data-table__th">Devolución Estimada/Real</th>
                <th class="data-table__th">Estado</th>
                <th class="data-table__th">Acción</th>
              </tr>
            </thead>
            <tbody class="data-table__body" id="tabla-cuerpo">
              <% if (prestamos && prestamos.length > 0) { %>
                <% prestamos.forEach(p => { %>
                  <tr class="data-table__row fila-datos">
                    <td class="data-table__td">
                      <strong class="celda-codigo" style="font-family: var(--font-mono); color: var(--color-primary);"><%= p.codigo_herramienta %></strong><br>
                      <span class="celda-nombre" style="font-size: 11px; color: var(--color-text-muted);"><%= p.nombre_herramienta %></span>
                    </td>
                    <td class="data-table__td" data-label="Operario" style="font-weight: 600; color: var(--color-text-secondary);">
                      <%= p.nombre_operario %>
                    </td>
                    <td class="data-table__td" data-label="Destino" style="font-size: 13px;">
                      <%= p.sector_destino %>
                    </td>
                    <td class="data-table__td" data-label="Fecha Salida" style="font-size: 13px;">
                      <%= new Date(p.fecha_salida).toLocaleDateString('es-AR') %>
                    </td>
                    <td class="data-table__td" data-label="Devolución" style="font-size: 13px;">
                      <% if (p.fecha_devolucion_real) { %>
                        <span style="color: #059669; font-weight: 700;">Real: <%= new Date(p.fecha_devolucion_real).toLocaleDateString('es-AR') %></span>
                      <% } else { %>
                        <span style="color: #d97706;">Estimada: <%= new Date(p.fecha_devolucion_estimada).toLocaleDateString('es-AR') %></span>
                      <% } %>
                    </td>
                    <td class="data-table__td" data-label="Estado">
                      <%
                        let badgeClass = 'badge--success';
                        if (p.estado_prestamo === 'Activo') badgeClass = 'badge--warning';
                        if (p.estado_prestamo === 'Devuelto con daño') badgeClass = 'badge--danger';
                      %>
                      <span class="badge <%= badgeClass %>"><%= p.estado_prestamo %></span>
                    </td>
                    <td class="data-table__td" data-label="Acción">
                      <% if (p.estado_prestamo === 'Activo') { %>
                        <form action="/Tools/Devolucion" method="POST" style="margin: 0;">
                          <input type="hidden" name="id_herramienta" value="<%= p.id_herramienta %>">
                          <button type="submit" style="background-color: #059669; color: white; border: none; padding: 6px 12px; border-radius: 6px; font-weight: 700; font-size: 11px; cursor: pointer; transition: 0.2s;" onmouseover="this.style.backgroundColor='#047857'" onmouseout="this.style.backgroundColor='#059669'">
                            ✓ Devolver
                          </button>
                        </form>
                      <% } else { %>
                        <span style="font-size: 11px; color: var(--color-text-muted);">Cerrado</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="data-table__td" style="text-align: center; padding: 40px; color: var(--color-text-muted);">No hay préstamos registrados en la base de datos.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script src="/js/sidebar.js"></script>
  <script>
    /* ── FIX BOTÓN HAMBURGUESA BLINDADO ── */
    document.addEventListener('DOMContentLoaded', () => {
      const topbar = document.querySelector('.topbar') || document.querySelector('.app-header');
      if (!topbar) return;
      const btnHamburguesa = topbar.querySelector('button') || document.getElementById('menu-toggle');
      const sidebar = document.getElementById('mi-sidebar-blindado');
      const overlay = document.getElementById('sb-overlay-blindado');
      if (btnHamburguesa && sidebar && overlay) {
        const nuevoBtn = btnHamburguesa.cloneNode(true);
        btnHamburguesa.parentNode.replaceChild(nuevoBtn, btnHamburguesa);
        nuevoBtn.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          sidebar.classList.toggle('abierto'); overlay.classList.toggle('activo');
        });
      }
    });

    // LÓGICA FRONT-END: Filtros y Exportación
    document.addEventListener('DOMContentLoaded', () => {
        const inpTexto = document.getElementById('filtro-texto');
        const selEstado = document.getElementById('filtro-estado');
        const inpFecha = document.getElementById('filtro-fecha');
        const btnLimpiar = document.getElementById('btn-limpiar');
        const filas = document.querySelectorAll('.fila-datos');

        function filtrarTabla() {
            const t = inpTexto.value.toLowerCase();
            const e = selEstado.value.toLowerCase();
            const f = inpFecha.value;

            // Convertir la fecha YYYY-MM-DD del input a formato local para poder comparar string
            let fechaFormat = "";
            if (f) {
                const [year, month, day] = f.split('-');
                fechaFormat = `${day}/${month}/${year}`;
            }

            filas.forEach(fila => {
                const textoFila = fila.innerText.toLowerCase();
                const estadoCelda = fila.querySelector('td[data-label="Estado"]').innerText.toLowerCase();
                const salidaCelda = fila.querySelector('td[data-label="Fecha Salida"]').innerText;

                const cumpleTexto = t === '' || textoFila.includes(t);
                const cumpleEstado = e === '' || estadoCelda.includes(e);
                const cumpleFecha = f === '' || salidaCelda.includes(fechaFormat);

                if (cumpleTexto && cumpleEstado && cumpleFecha) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        }

        if(inpTexto) inpTexto.addEventListener('input', filtrarTabla);
        if(selEstado) selEstado.addEventListener('change', filtrarTabla);
        if(inpFecha) inpFecha.addEventListener('change', filtrarTabla);

        if(btnLimpiar) {
            btnLimpiar.addEventListener('click', () => {
                inpTexto.value = '';
                selEstado.value = '';
                inpFecha.value = '';
                filtrarTabla();
            });
        }

        // ── Exportación a Excel con la librería SheetJS ──
        const btnExportar = document.getElementById('btn-exportar');
        if (btnExportar) {
            btnExportar.addEventListener('click', () => {
                if (typeof XLSX === 'undefined') { alert("Cargando componentes..."); return; }
                
                let datosExcel = [['Código', 'Herramienta', 'Operario/Responsable', 'Sector Destino', 'Fecha Salida', 'Devolución Estimada/Real', 'Estado']];

                filas.forEach(fila => {
                    if(fila.style.display !== 'none') {
                        const codigo = fila.querySelector('.celda-codigo') ? fila.querySelector('.celda-codigo').innerText.trim() : '';
                        const nombreH = fila.querySelector('.celda-nombre') ? fila.querySelector('.celda-nombre').innerText.trim() : '';
                        const operario = fila.querySelector('td[data-label="Operario"]').innerText.trim();
                        const destino = fila.querySelector('td[data-label="Destino"]').innerText.trim();
                        const salida = fila.querySelector('td[data-label="Fecha Salida"]').innerText.trim();
                        const devolucion = fila.querySelector('td[data-label="Devolución"]').innerText.trim();
                        const estadoPrestamo = fila.querySelector('td[data-label="Estado"]').innerText.trim();

                        datosExcel.push([codigo, nombreH, operario, destino, salida, devolucion, estadoPrestamo]);
                    }
                });

                if(datosExcel.length === 1) { alert("No hay datos para exportar con los filtros actuales."); return; }

                const ws = XLSX.utils.aoa_to_sheet(datosExcel);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Prestamos");
                XLSX.writeFile(wb, 'Historial_Prestamos.xlsx');
            });
        }
    });
  </script>

</body>
</html>