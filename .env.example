# Copiá este archivo a .env y completá los valores reales. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vehiculos_db
DB_USER=root
DB_PASSWORD=
# Contraseña del usuario "admin" que se crea la primera vez sobre una base vacía (si no se define: Ficha2026! en desarrollo, y una al azar en producción)
ADMIN_PASSWORD=
# Carpeta base de los documentos adjuntos (se guardan en <UPLOADS_DIR>/documentos). Por defecto: ./uploads
UPLOADS_DIR=
# Contraseña del usuario "usuario" (sin reportes ni auditoría) que se crea la primera vez (npm run usuarios o Docker) (por defecto: Usuario2026!)
USUARIO_PASSWORD=
